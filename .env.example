# MVA Live Scoreboard Environment Configuration Example
# Do not commit real credentials or production secrets to this file or source control.

# Existing migration/operator connections only. Never use these in app runtime.
DATABASE_URL=postgresql://user:password@localhost:5432/mva_dev
DIRECT_URL=postgresql://user:password@localhost:5432/mva_dev

# Restricted server-only scoreboard runtime, after separate database approval.
# Use scoreboard_runtime only. No browser bundle or NEXT_PUBLIC_ prefix.
# Local PostgreSQL and online Supabase connection values are provisioned separately.
SCOREBOARD_DATABASE_URL=postgresql://scoreboard_runtime:password@localhost:5432/mva_dev
SCOREBOARD_EXPECTED_DATABASE=mva_dev
SCOREBOARD_DATABASE_TARGET=local

# Server-only MVA Catalog Integration (Phase 02)
# Never expose MVA_SCOREBOARD_INTEGRATION_TOKEN in NEXT_PUBLIC_ variables or client bundles.
# Must match the MVA_SCOREBOARD_INTEGRATION_TOKEN configured on the MVA application server.
MVA_CATALOG_BASE_URL=http://localhost:3000
MVA_SCOREBOARD_INTEGRATION_TOKEN=replace-with-at-least-32-char-random-machine-token
# Optional comma-separated HTTPS host allowlist for official team logos (in addition to NEXT_PUBLIC_SUPABASE_URL host)
MVA_LOGO_ALLOWED_HOSTS=your-project.supabase.co

# Supabase Auth Configuration
# Uses the existing configured MVA Supabase Auth project issuer
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Cookie isolation between localhost:3000 (MVA) and localhost:3001 (Scoreboard)
# Prevents cross-app session stomping on shared localhost domain
NEXT_PUBLIC_SUPABASE_COOKIE_NAME=sb-mva-scoreboard-auth-token
